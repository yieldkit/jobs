{
  "name": "@yieldkit/jobs",
  "version": "0.3.0",
  "description": "Durable scheduled and on-demand jobs for Effect on PostgreSQL, on the Effect Cluster you bring: cron schedules, a fenced run ledger, retries and explicit migrations.",
  "keywords": [
    "cron",
    "durable-execution",
    "effect",
    "effect-cluster",
    "effect-ts",
    "jobs",
    "postgresql",
    "scheduler",
    "workflow"
  ],
  "homepage": "https://github.com/yieldkit/jobs#readme",
  "bugs": "https://github.com/yieldkit/jobs/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yieldkit/jobs.git"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "effect-tsgo vp check",
    "lint:fix": "effect-tsgo vp check --fix",
    "prepack": "vp pack",
    "prepare": "vp config",
    "ready": "pnpm check && pnpm test",
    "test": "vp test --project unit",
    "test:integration": "vp test --project integration",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yieldkit/logger": "catalog:",
    "@yieldkit/pg": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/tsgo": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@yieldkit/oxlint-config": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/sql-pg": "~4.1.7",
    "effect": "~4.1.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
